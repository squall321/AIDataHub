# PostgreSQL connection
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_data
# Connection pool — 한 번에 쥘 수 있는 커넥션은 DB_POOL_SIZE + DB_MAX_OVERFLOW (기본 12 + 8).
# DB_POOL_TIMEOUT 은 풀이 다 찼을 때 줄 서는 시간(초). 합이 PG max_connections 를 넘지 않게 한다.
# ⚠ Apptainer 배포는 start_api.sh 가 이 .env 를 기동 때마다 다시 쓴다 — 그 박스에서는
#   deploy/apptainer/.env 에 넣는다.
# DB_POOL_SIZE=12
# DB_MAX_OVERFLOW=8
# DB_POOL_TIMEOUT=60
# 새 PG 연결을 맺는 한도(초). 죽은 PG 를 재는 값이라 짧다 — DB_POOL_TIMEOUT 보다 작게 둔다
# (같으면 'PG 가 죽었다' 와 '풀이 찼다' 가 같은 시각에 터져 구별되지 않는다).
# AIDH_DB_CONNECT_TIMEOUT_S=10
# 검색(MCP agent_search·semantic_search·hybrid_search·fts_search) 트랜잭션의 문장 하나가 돌 수 있는
# 시간(초). 0 이면 끈다. DB_POOL_TIMEOUT 과 더한 값이 부르는 쪽의 대기(심의 엔진 180초)보다 작아야 한다.
# AIDH_SEARCH_STATEMENT_TIMEOUT_S=90
# /api/system/health 가 게이지(미임베딩 건수·동기화 정체) 쿼리를 기다리는 시간(초). 넘으면 게이지만 null 로
# 두고 곧바로 200 을 준다. 0 이면 끈다. 프로세스 생사는 DB 를 쓰지 않는 /health 로 본다.
# AIDH_HEALTH_GAUGE_TIMEOUT_S=2

# API server
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Logging
LOG_LEVEL=INFO

# Authentication — set true to require X-API-Key on all routes.
# AUTH_REQUIRED=false
# Bootstrap key (first issuance / key management). Leave empty to disable.
# BOOTSTRAP_API_KEY=

# Upload limits
# MAX_UPLOAD_MB=50

# CORS — vscode-webview://* 는 항상 허용된다. 운영용 추가 오리진을 콤마로 나열.
# 예: EXTRA_ALLOWED_ORIGINS=https://datahub.example.com,https://staging.x.io
# EXTRA_ALLOWED_ORIGINS=

# Build identifier — /api/system/health 응답의 build 필드.
# BUILD_SHA=dev

# ── recommend_agents 라우팅 튜닝(전문가 추천 정합도) ──────────────────────────
# 추천은 데이터 기반(레코드/섹션 의미검색 + 샘플질의) + 역할/설명 어휘매칭의 합산 점수다.
# 풀이 커지면 데이터 얇은 전문가가 후보에서 밀리므로 어휘매칭(DESC) 가중으로 보정한다.
#
# 샘플질의 채널 가중 — agent_sample_embeddings 평균에 곱하는 계수(0=끔).
# AGENT_SAMPLE_WEIGHT=1.0
# 샘플질의 상위 K개만 채택.
# AGENT_SAMPLE_TOP_K=20
# 에이전트별 샘플질의 채택 상한(한 에이전트가 상위권을 독점하지 않게).
# AGENT_SAMPLE_PER_AGENT_CAP=3
# 역할/설명 어휘매칭 가중 — 질의 distinctive 토큰(조사·불용어 제거 후)이 name/description/
# tags/data_types 에 겹친 비율에 곱한다. 데이터가 얇아도 역할이 맞으면 상위로 올린다.
# 기본 2.0: 강한 이름일치(frac→1.0)가 데이터 많은 무관 에이전트(~1.85)를 이겨야 하기 때문.
# 낮추면 데이터 우위, 너무 높이면 어휘 우연일치가 끼어든다.
# AGENT_DESC_WEIGHT=2.0
