# PostgreSQL connection
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_data

# API server
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Logging
LOG_LEVEL=INFO

# Authentication — set true to require X-API-Key on all routes.
# AUTH_REQUIRED=false
# Bootstrap key (first issuance / key management). Leave empty to disable.
# BOOTSTRAP_API_KEY=

# Upload limits
# MAX_UPLOAD_MB=50

# CORS — vscode-webview://* 는 항상 허용된다. 운영용 추가 오리진을 콤마로 나열.
# 예: EXTRA_ALLOWED_ORIGINS=https://datahub.example.com,https://staging.x.io
# EXTRA_ALLOWED_ORIGINS=

# Build identifier — /api/system/health 응답의 build 필드.
# BUILD_SHA=dev

# ── recommend_agents 라우팅 튜닝(전문가 추천 정합도) ──────────────────────────
# 추천은 데이터 기반(레코드/섹션 의미검색 + 샘플질의) + 역할/설명 어휘매칭의 합산 점수다.
# 풀이 커지면 데이터 얇은 전문가가 후보에서 밀리므로 어휘매칭(DESC) 가중으로 보정한다.
#
# 샘플질의 채널 가중 — agent_sample_embeddings 평균에 곱하는 계수(0=끔).
# AGENT_SAMPLE_WEIGHT=1.0
# 샘플질의 상위 K개만 채택.
# AGENT_SAMPLE_TOP_K=20
# 에이전트별 샘플질의 채택 상한(한 에이전트가 상위권을 독점하지 않게).
# AGENT_SAMPLE_PER_AGENT_CAP=3
# 역할/설명 어휘매칭 가중 — 질의 토큰이 name/description/tags/data_types 에 겹친 비율에 곱한다.
# 데이터가 얇아도 역할이 맞으면 추천되게 하는 보정항. 과하면 어휘 우연일치가 끼므로 0.4~0.8 권장.
# AGENT_DESC_WEIGHT=0.6
